# Exemplo de variáveis de ambiente (copie para .env na raiz se desejar)
# Execução local (venv) e Docker respeitam estas variáveis.

# Whisper
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1

# Upload/Arquivos temporários
TMP_AUDIO_DIR=./data/tmp
MAX_UPLOAD_MB=50

# API
DEMO_MODE=true

# Banco de dados (default: SQLite local)
# Ex.: sqlite:///./data/app.db  |  postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db
